{
  "name": "business-suite-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "description": "ForgeFlow MES Go + React desktop workspace",
  "author": "Business Suite",
  "build": {
    "appId": "org.blockchen.forgeflow.mes",
    "productName": "ForgeFlow MES",
    "directories": {
      "output": "../outputs/desktop"
    },
    "files": [
      "main.cjs",
      "paths.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../outputs/go/business-suite.exe",
        "to": "backend/business-suite.exe"
      },
      {
        "from": "../web-dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "asar": true,
    "electronVersion": "45.1.0"
  }
}
