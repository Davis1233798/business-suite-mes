FROM node:24-bookworm-slim AS web-build
WORKDIR /source
ENV SHARP_IGNORE_GLOBAL_LIBVIPS=1 ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci --include=dev --include=optional --no-audit --no-fund
COPY web/ ./web/
COPY public/ ./public/
COPY app/globals.css app/suite.css app/expressive.css ./app/
COPY vendor/shadcn-tailwind-4.13.0.css ./vendor/
RUN npm run web:build

FROM golang:1.26-bookworm AS build
WORKDIR /source
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /out/station-server .

FROM debian:bookworm-slim
WORKDIR /srv/station
RUN useradd -r -u 10001 station && mkdir -p /srv/station/data && chown station:station /srv/station/data
COPY --from=build /out/station-server /srv/station/station-server
COPY --from=web-build /source/web-dist/ /srv/station/web-dist/
ENV SUITE_WEB=/srv/station/web-dist SUITE_DB=/srv/station/data/stations.sqlite SUITE_ADDR=0.0.0.0:8095
USER station
EXPOSE 8095
CMD ["/srv/station/station-server"]
